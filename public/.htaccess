# SPA fallback untuk React Router.
DirectoryIndex index.html

# Aktifkan rewrite jika tersedia.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # (Opsional) Reverse proxy same-origin /api ke backend.
  # RewriteRule ^api/(.*)$ https://be.sawitq.my.id/api/$1 [P,L]
  # RequestHeader set X-API-KEY "your-api-key-1"

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Fallback sederhana (Apache 2.2.16+) jika mod_rewrite tidak aktif.
<IfModule mod_dir.c>
  FallbackResource /index.html
</IfModule>

Options -Indexes
