# ============================================================
# Mode proxy (default, disarankan)
# ============================================================
# Saat `npm run dev`, Vite mem-proxy /api ke target di bawah dan
# menyisipkan header X-API-KEY. Di hosting, pasang reverse proxy
# /api ke backend dengan aturan yang setara.
SAWITQ_API_TARGET=https://be.sawitq.my.id
SAWITQ_API_KEY=your-api-key-1

# ============================================================
# Mode langsung (tanpa reverse proxy)
# ============================================================
# Diperlukan saat `npm run build` untuk hosting statis yang tidak
# punya proxy. Nilai VITE_* ikut ter-bundle dan dapat dibaca siapa
# saja dari browser, jadi jangan taruh rahasia sungguhan di sini.
# Backend harus mengizinkan CORS dari domain web.
# VITE_API_BASE_URL=https://be.sawitq.my.id/api
# VITE_API_KEY=your-api-key-1
